# ==============================
# 🌍 Environment
# ==============================
APP_ENV=dev
ENVIRONMENT=dev

# ==============================
# 🚀 Application
# ==============================
APP_NAME=RAG Evaluation Service
APP_VERSION=1.0.0
DESCRIPTION=API service for evaluating Retrieval-Augmented Generation (RAG)
API_PREFIX=/api
DEBUG_MODE=true

# ==============================
# 🌐 Server
# ==============================
DOMAIN=localhost
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==============================
# 🌍 CORS
# ==============================
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==============================
# 🗄️ Database
# ==============================
DB_PROVIDER=postgresql

POSTGRESQL_USERNAME=admin
POSTGRESQL_PASSWORD=admin
POSTGRESQL_SERVER=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=db_rag_eval

# Optional override (recommended to keep)
DATABASE_URL=postgresql+asyncpg://${POSTGRESQL_USERNAME}:${POSTGRESQL_PASSWORD}@${POSTGRESQL_SERVER}:${POSTGRESQL_PORT}/${POSTGRESQL_DATABASE}

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# SQLite fallback
SQLITE_URL=sqlite+aiosqlite:///./test.db

# ==============================
# 🔴 Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER_NAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
# REDIS_URL=redis://localhost:6379/0

# ==============================
# 🔐 Security / JWT
# ==============================
SECRET_KEY=dev-secret-key-minimum-32-characters-long-only
JWT_SECRET_KEY=dev-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_CONFIRMATION_TOKEN_EXPIRE_MINUTES=10

# ==============================
# 🤖 LLM Providers
# ==============================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

DEFAULT_LLM_PROVIDER=ollama
DEFAULT_GENERATION_MODEL_NAME=qwen2.5:latest
DEFAULT_EMBEDDINGS_MODEL_NAME=nomic-embed-text:latest

GENERATION_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

PGVECTOR_COLLECTION=knowledge_base
PGVECTOR_ENABLED=false

# ==============================
# 🔎 Research / Tools
# ==============================
TAVILY_API_KEY=

# ==============================
# 📊 Observability
# ==============================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json; console

SENTRY_DSN=

# LangSmith (optional)
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lavie

# OpenTelemetry
# Leave empty for local dev (console tracing)
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORTER_ENABLED=false
# ENVIRONMENT=production
# OTEL_EXPORTER_ENDPOINT=https://otel.company.com/v1/traces

# ==============================
# ⚙️ RAG / Agent Config
# ==============================
AGENT_MAX_CONTEXT_TOKENS=12000
SUPERVISOR_ROUTING_MAX_TOKENS=2048
MAX_TOOL_OUTPUT_CHARS=10000

MEMORY_SUMMARIZATION_TRIGGER_MESSAGES=40
MEMORY_SUMMARIZATION_KEEP_RECENT_MESSAGES=12
MEMORY_SUMMARY_MAX_CHARS=4000

MEMORY_SUMMARIZER_PROVIDER=
MEMORY_SUMMARIZER_MODEL_NAME=

# ==============================
# 📨 Email
# ==============================
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=noreply@example.com

# ==============================
# ⚡ Rate Limiting
# ==============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=2

# ==============================
# 🚩 Feature Flags
# ==============================
FEATURE_SEMANTIC_SEARCH=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_BACKGROUND_TASKS=true

# ==============================
# 🧵 Celery
# ==============================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==============================
# 📂 Prompt Assets (optional)
# ==============================
PROMPT_ASSETS_DIR=
PROMPT_REGISTRY_PATH=
